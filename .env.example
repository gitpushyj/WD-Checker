# ─────────────────────────────────────────────────────────────────────
#  ⚠️  이 파일(.env.example)에는 실제 값을 넣지 마세요.
#      git 에 그대로 올라갑니다. 여기는 "무엇을 채워야 하는지" 적어두는 견본입니다.
#
#      실제 비밀번호는 .env 에 넣습니다. .env 는 git 에서 제외됩니다.
#          cp .env.example .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────────────

# 보내는 계정. 본인 Gmail 주소를 적습니다.
SMTP_USER=

# 앱 비밀번호 16자리. 계정 비밀번호가 아닙니다.
#   2단계 인증을 켠 뒤 https://myaccount.google.com/apppasswords 에서 발급
#   발급할 때 적은 "앱 이름"은 구글이 구분하려고 붙이는 이름표일 뿐이라
#   여기에 적을 필요가 없습니다. 필요한 건 위 주소와 아래 16자리뿐입니다.
#   공백은 있어도 되고 없어도 됩니다.
SMTP_PASSWORD=

# 받는 사람. 비워두면 보내는 계정 자신에게 보냅니다.
# 여러 명에게 보내려면 쉼표로 구분하세요. 세미콜론도 됩니다.
#   MAIL_TO=나@gmail.com, 배우자@gmail.com, 어머니@naver.com
MAIL_TO=

# 비밀번호를 파일에 두기 싫다면 SMTP_PASSWORD 를 비운 채 키체인에 넣으세요.
#   security add-generic-password -s snu-wedding-watch -a 본인주소@gmail.com -w
# 네이버 메일을 쓰려면 아래 줄의 주석을 푸세요.
# SMTP_HOST=smtp.naver.com

# Slack 도 함께 쓰려면 웹훅 URL 을. 안 쓰면 비워두세요.
SLACK_WEBHOOK_URL=

# 알림 문구에 표시될 출처 이름 (맥/GitHub 구분용)
WATCH_SOURCE=로컬
